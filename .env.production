# Firebase web config for shot-tracker-30ab7.
#
# These values are NOT secrets. Vite bakes them into the JavaScript bundle, so
# they are already public on any deployed build — Google documents the web
# config as public information. What actually protects your data is
# firestore.rules, not the secrecy of these values.
#
# They live here (committed) rather than in .env.local so that CI can build a
# correctly-configured bundle without six separate GitHub secrets to keep in
# sync — a mismatch there silently ships a build that falls back to
# localStorage.
VITE_FIREBASE_API_KEY=AIzaSyAKosFjmk3LsfX1CAPnmARTOfnJ4zEbgFU
VITE_FIREBASE_AUTH_DOMAIN=shot-tracker-30ab7.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shot-tracker-30ab7
VITE_FIREBASE_STORAGE_BUCKET=shot-tracker-30ab7.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=162356942061
VITE_FIREBASE_APP_ID=1:162356942061:web:e04d02da840625ea5ce8e4
